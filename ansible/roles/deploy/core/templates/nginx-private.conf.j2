server {
  listen 80 default_server;
  server_name _;

  resolver 127.0.0.11 valid=10s ipv6=off;
  resolver_timeout 5s;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location = / {
    return 404;
  }

  location /seaweed/master/ {
    set $upstream seaweedfs:9333;
    proxy_pass http://$upstream/;
  }

  location /seaweed/filer/ {
    set $upstream seaweedfs:8888;
    proxy_pass http://$upstream/;
  }

  location /grafana/ {
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Prefix /grafana;
    set $upstream grafana:3000;
    proxy_pass http://$upstream/;
  }

  location /prometheus/ {
    set $upstream prometheus:9090;
    proxy_pass http://$upstream/;
  }

  location /loki/ {
    set $upstream loki:3100;
    proxy_pass http://$upstream/;
  }
}

{% for vhost in core_vhosts | selectattr('exposure', 'equalto', 'private') %}
{% if vhost.http.enabled | default(true) %}
server {
  listen 80;
  server_name {{ vhost.domains | join(' ') }};

  resolver 127.0.0.11 valid=10s ipv6=off;
  resolver_timeout 5s;

  location / {
{% if vhost.http.redirect_to_https | default(false) %}
    return 301 https://$host$request_uri;
{% else %}
{% if vhost.preserve_host | default(false) %}
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
{% endif %}
    proxy_set_header X-Forwarded-Proto $scheme;
    set $upstream {{ vhost.upstream }};
    proxy_pass http://$upstream;
{% endif %}
  }
}

{% endif %}
{% endfor %}
