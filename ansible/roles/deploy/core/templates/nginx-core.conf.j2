server {
  listen 80 default_server;
  server_name _;

  resolver 127.0.0.11 valid=10s ipv6=off;
  resolver_timeout 5s;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    try_files $uri =404;
  }

  location = / {
    default_type text/plain;
    return 200 "infra-macro-vps core gateway\n";
  }

  location /couchdb/ {
    set $upstream couchdb:5984;
    proxy_pass http://$upstream/;
  }

  location /seaweed/master/ {
    set $upstream seaweedfs:9333;
    proxy_pass http://$upstream/;
  }

  location /seaweed/filer/ {
    set $upstream seaweedfs:8888;
    proxy_pass http://$upstream/;
  }

  location /seaweed/s3/ {
    set $upstream seaweedfs:8333;
    proxy_pass http://$upstream/;
  }

  location /grafana/ {
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Prefix /grafana;
    set $upstream grafana:3000;
    proxy_pass http://$upstream/;
  }

  location /prometheus/ {
    set $upstream prometheus:9090;
    proxy_pass http://$upstream/;
  }

  location /loki/ {
    set $upstream loki:3100;
    proxy_pass http://$upstream/;
  }
}

server {
  listen 80;
  server_name {{ seaweed_domain }};

  resolver 127.0.0.11 valid=10s ipv6=off;
  resolver_timeout 5s;

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    try_files $uri =404;
  }

{% if core_tls_enabled %}
  location / {
    return 301 https://$host$request_uri;
  }
{% else %}
  location / {
    set $upstream seaweedfs:9333;
    proxy_pass http://$upstream;
  }
{% endif %}
}

{% if core_tls_enabled %}
server {
  listen 443 ssl;
  server_name {{ seaweed_domain }};

  resolver 127.0.0.11 valid=10s ipv6=off;
  resolver_timeout 5s;

  ssl_certificate /etc/letsencrypt/live/{{ seaweed_domain }}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{ seaweed_domain }}/privkey.pem;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 10m;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  location / {
    set $upstream seaweedfs:9333;
    proxy_pass http://$upstream;
  }
}
{% endif %}
